model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["Fact_Exposure","Security_UserCountry","Dim_Counterparty","Dim_Segment","Dim_Country","Dim_Scenario","Dim_Date","_Measures","DQ_Reconciliation"]

annotation PBI_ProTooling = ["DevMode"]

ref table Fact_Exposure
ref table Security_UserCountry
ref table Dim_Counterparty
ref table Dim_Segment
ref table Dim_Country
ref table Dim_Scenario
ref table Dim_Date
ref table _Measures
ref table DQ_Reconciliation

ref role 'Country Manager'
ref role 'Group Viewer'

ref cultureInfo en-US


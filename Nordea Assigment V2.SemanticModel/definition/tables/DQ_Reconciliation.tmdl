		isHidden
		formatString: 0
		lineageTag: 385e8433-949c-430e-8f64-a948949358bc
		summarizeBy: none
		sourceColumn: SortOrder

		changedProperty = SortByColumn

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column Check
		dataType: string
		lineageTag: 055d7ee8-d008-4f80-a7eb-67f4c9b8c8d3
		summarizeBy: none
		sourceColumn: Check
		sortByColumn: SortOrder

